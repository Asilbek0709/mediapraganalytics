# MediaPrag-Analytics — muhit o‘zgaruvchilari namunasi.
# Kompyuterda: nusxasini .env.local nomi bilan saqlang (u git’ga tushmaydi). Vercel’da: Project → Settings → Environment Variables.
# Haqiqiy qiymatlarni hech qachon shu faylga yozmang.

# PostgreSQL ulanish satri (Supabase: Project → Connect → Transaction pooler, port 6543).
# Bo‘sh qolsa — kompyuterdagi PGlite bazasi (data/pglite papkasi). Vercel’da — majburiy.
DATABASE_URL=

# Birinchi administratorni yaratish uchun bir martalik kalit (kamida 12 belgi).
# Faqat tashqi bazada (DATABASE_URL bilan) kerak; administrator yaratilgach, uni o‘chirib qo‘yish mumkin.
MEDIAPRAG_SOZLASH_KALITI=

# Kunlik zaxira (Vercel Cron, vercel.json): Vercel shu kalit bilan /api/cron/zaxira ni chaqiradi.
CRON_SECRET=

# AI-taklif (Claude): Anthropic API kaliti — faqat serverda. Bo‘sh bo‘lsa, AI tugmasi ko‘rinmaydi.
ANTHROPIC_API_KEY=

# Ixtiyoriy:
# MEDIAPRAG_DB=data/pglite          # PGlite papkasi (DATABASE_URL bo‘lmaganda)
# MEDIAPRAG_TZ=Asia/Tashkent        # yozuvlardagi vaqt zonasi
# MEDIAPRAG_AVTO_ZAXIRA=0           # kunlik avtomatik zaxirani o‘chirish
# MEDIAPRAG_NAMOYISH=1             # namoyish (demo) bazasi: sun’iy namunalar ham statistikada ko‘rinadi
# MEDIAPRAG_AI_MODEL=claude-opus-5-5  # AI modeli
# MEDIAPRAG_AI_EFFORT=high          # AI fikrlash chuqurligi: low | medium | high | xhigh | max
# MEDIAPRAG_HTTPS=1                 # o‘z serveringizda HTTPS orqali ishlasa — Secure cookie
